rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Solo permitimos acceso a la colección específica de entrenamiento del MVP CallVoxky
    match /callvoxky_entrenamiento/{documentoId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 6);
    }
  }
}
