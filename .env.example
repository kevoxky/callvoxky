# Archivo: .env.example
# Qué hace: Plantilla de ejemplo con las variables de configuración que usará CallVoxky (sin claves reales).
# Con qué se conecta: Sirve de guía para crear tu archivo privado ".env" (el cual nunca se sube a internet gracias a .gitignore).

# ====================================================================
# 1. SERVIDOR LOCAL (NODE.JS 26 LTS)
# ====================================================================
# Puerto donde funcionará nuestro servidor de control y demostración WebRTC
PUERTO_SERVIDOR=3001
ENTORNO=desarrollo

# ====================================================================
# 2. CEREBRO DE VOZ Y RAZONAMIENTO (OPENAI GPT-LIVE)
# ====================================================================
# Clave secreta del proyecto de https://platform.openai.com (empieza por sk-...)
OPENAI_API_KEY=pon_aqui_tu_clave_de_openai_sin_comillas

# ID de tu proyecto de OpenAI (necesario en la Fase 3 para la ruta SIP: sip:$OPENAI_PROJECT_ID@sip-eu.api.openai.com)
OPENAI_PROJECT_ID=proj_pon_aqui_el_id_de_tu_proyecto

# Secreto para verificar la firma de los webhooks entrantes de OpenAI (live.transport.incoming)
OPENAI_WEBHOOK_SECRET=whsec_pon_aqui_el_secreto_del_webhook

# Modelos oficiales aprobados para CallVoxky
OPENAI_MODELO_VOZ=gpt-live-1
OPENAI_MODELO_BACKEND=gpt-6-luna
OPENAI_VOZ_POR_DEFECTO=marin

# ====================================================================
# 3. LÍMITES DE CONCURRENCIA Y SEGURIDAD DE COSTES
# ====================================================================
# Niveles oficiales de GPT-Live en OpenAI: Build (50), Launch (300), Grow (500)
# Ponemos 45 por defecto para dejar margen de seguridad dentro del nivel Build (50)
MAX_SESIONES_GLOBALES=45

# Límite por defecto de llamadas simultáneas para una empresa individual
MAX_LLAMADAS_SIMULTANEAS_POR_EMPRESA=2

# Duración máxima permitida por llamada en segundos (300 seg = 5 minutos)
MAX_DURACION_LLAMADA_SEGUNDOS=300

# Tiempo máximo de silencio/inactividad antes de cerrar la sesión automáticamente (en segundos)
TIMEOUT_INACTIVIDAD_SEGUNDOS=25

# ====================================================================
# 4. FASES POSTERIORES (NO NECESARIAS PARA LA 1ª DEMOSTRACIÓN WEBRTC)
# ====================================================================
# Telnyx SIP (Fase 3 - Telefonía española +34)
TELNYX_API_KEY=pendiente_fase_3
TELNYX_NUMERO_ESPANA=+34910000000

# Firebase Firestore y Auth (Fases 4 y 5 - Base de datos y Panel Web)
FIREBASE_PROJECT_ID=pendiente_fase_4

# WhatsApp Business Cloud API (Fase 6 - Mensajería de texto)
WHATSAPP_TOKEN_ACCESO=pendiente_fase_6
WHATSAPP_ID_TELEFONO=pendiente_fase_6
WHATSAPP_TOKEN_VERIFICACION_WEBHOOK=pendiente_fase_6

