# Archivo: .env.example
# Qué hace: Es una plantilla de ejemplo que muestra qué claves secretas necesita el proyecto.
# Con qué se conecta: Debes copiar este archivo con el nombre ".env" y poner ahí tus claves reales.

# 1. Clave de Google Gemini (Obligatoria para el cerebro de voz en vivo)
# Consíguela gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=PON_AQUI_TU_CLAVE_DE_GEMINI

# 2. Modelo de voz en tiempo real de Gemini con razonamiento inteligente activado (mismo precio)
GEMINI_MODELO_VOZ=gemini-3.8-live-extended-thinking
GEMINI_NIVEL_RAZONAMIENTO=MEDIUM

# 3. Puerto donde funcionará tu panel de entrenamiento en tu computadora (cámbialo si lo necesitas)
PUERTO=3456

# 4. Datos de Vonage (Opcionales al inicio; se usarán en el Paso 3 para el número telefónico de España)
VONAGE_APPLICATION_ID=PON_AQUI_TU_APP_ID_DE_VONAGE
VONAGE_PHONE_NUMBER=+34910000000
