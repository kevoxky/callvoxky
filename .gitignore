# Archivo: .gitignore
# Qué hace: Le dice a Git qué archivos NO debe guardar ni subir a internet.
# Con qué se conecta: Protege al archivo .env (donde van tus claves secretas) y carpetas pesadas.

# Claves secretas y configuración privada (NUNCA subir a internet)
.env
.env.local
.env.*.local

# Datos privados de entrenamiento local (los datos reales viven en Firebase y no deben ir a Git)
entrenamiento/datos_negocio.json

# Llaves privadas generadas automáticamente por la API de Vonage
telefonia/vonage_credenciales.json
*.key

# Dependencias instaladas (carpetas pesadas que se descargan solas)
node_modules/

# Archivos de registro de errores (logs) y archivos temporales
logs/
*.log
npm-debug.log*
tmp/
temp/

# Archivos propios del sistema operativo
.DS_Store
Thumbs.db
